@{
}

<div>
    <a asp-controller="Student" asp-action="Index" class="btn btn-secondary btn-sm"> Back to Student List</a>
</div>

<div class="container mt-5">
    <div class="card border-0 shadow mx-auto"
         style="max-width: 400px; border-radius: 12px;">

        <div class="card-body p-4">
            <h2 class="text-primary fw-bold text-center mb-2">
                Student
            </h2>

            <p class="text-secondary text-center mb-4">
                Create a new student account
            </p>

            <form action="/student/create" method="post">

                <div class="mb-3">
                    <input type="text" name="name"
                           class="form-control form-control-lg"
                           placeholder="Full name" />
                </div>

                <div class="mb-3">
                    <input type="text" name="department"
                           class="form-control form-control-lg"
                           placeholder="Department" />
                </div>

                <div class="mb-4">
                    <input type="text" name="cgpa"
                           class="form-control form-control-lg"
                           placeholder="CGPA" />
                </div>

                <button type="submit"
                        class="btn btn-primary btn-lg w-100 fw-bold">
                    Save Student
                </button>

            </form>
        </div>
    </div>
</div>
