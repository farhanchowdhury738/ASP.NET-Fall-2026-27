@{
}
@{
    ViewData["Title"] = "Course List";
}

<div class="container mt-4">
    <div class="col-md-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fs-4 mb-0">Student List</h2>

            <a asp-controller="Student"
               asp-action="Create"
               class="btn btn-primary btn-sm">
                + Create
            </a>
        </div>

        <table class="table table-bordered table-striped table-hover table-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Department</th>
                    <th>CGPA</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.name</td>
                        <td>@student.department</td>
                        <td>@student.cgpa</td>
                        <td class="text-center text-nowrap">
                            <a asp-controller="Student" asp-action="Update" asp-route-id="@student.id" class="btn btn-success btn-sm">Update</a>
                            <form asp-controller="Student" asp-action="Delete" asp-route-id="@student.id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this student?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
