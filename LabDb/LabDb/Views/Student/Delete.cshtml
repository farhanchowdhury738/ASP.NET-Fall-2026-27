@{
}

@model LabDb.Models.Student

<div class="card shadow-sm p-4 mx-auto mt-5" style="max-width: 350px">
    <h4 class="text-danger text-center">Delete Student</h4>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id" />

        <label class="form-label">Name</label>
        <input asp-for="name" class="form-control mb-3" readonly />

        <label class="form-label">Department</label>
        <input asp-for="department" class="form-control mb-3" readonly />

        <label class="form-label">CGPA</label>
        <input asp-for="cgpa" class="form-control mb-3" readonly />

        <p class="text-danger text-center">Are you sure you want to delete?</p>

        <button type="submit" class="btn btn-danger w-100 mb-2">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary w-100">
            Cancel
        </a>
    </form>
</div>
