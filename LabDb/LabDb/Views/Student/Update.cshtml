@{
}

@model LabDb.Models.Student

<div class="card shadow-sm p-4 mx-auto mt-5" style="max-width: 350px">
    <h4 class="text-primary text-center">Update Student</h4>

    <form asp-action="Update" method="post">
        <input type="hidden" asp-for="id" />

        <input asp-for="name" class="form-control mb-3" placeholder="Name" />
        <input asp-for="department" class="form-control mb-3" placeholder="Department" />
        <input asp-for="cgpa" class="form-control mb-3" placeholder="CGPA" />

        <button type="submit" class="btn btn-primary w-100">Update</button>
    </form>
</div>
