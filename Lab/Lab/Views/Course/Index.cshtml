@{
}
@model List<Lab.Models.Course>

<h2>Course List</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    Create Course
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Course Code</th>
            <th>Course Hours</th>
            <th>Semester Fee</th>
            <th>Actions</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var course in Model)
        {
            <tr>

                <td>@course.Name</td>
                <td>@course.email</td>
                <td>@course.courseCode</td>
                <td>@course.CourseHours</td>
                <td>@course.SemesterFee</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@course.Id"
                       class="btn btn-primary">Edit</a>

                    <form asp-action="Delete"
                          asp-route-id="@course.Id"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this course?')">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>