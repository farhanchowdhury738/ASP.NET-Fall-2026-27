*@
@{
}

<div >
    <a href="@Url.Action("Index", "Student")" class="btn btn-secondary">Back</a>
</div>


<h2>Student List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @* Sample data for demonstration purposes *@
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Email</td>
               <td>
                    <a asp-controller="Student"
                       asp-action="Details"
                       asp-route-id="@student.Id"
                       class="btn btn-primary">
                        Details
                    </a>
               </td>     
            </tr>
        }
    </tbody>
</table>
